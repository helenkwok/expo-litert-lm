{
  "name": "expo-litert-lm",
  "version": "0.3.0-rc.0",
  "description": "Expo Modules bindings for on-device LLM inference. Android: Google's litert-lm-android (LiteRT-LM Engine + MediaPipe Tasks GenAI). iOS: Google's first-party LiteRT-LM Swift APIs (v0.12.0+) with Metal GPU acceleration; MediaPipe Tasks GenAI available as opt-in MediaPipeFallback subspec. Web: Google's @litert-lm/core for .litertlm (WebGPU/CPU) + @mediapipe/tasks-genai for .task — both opt-in peer deps. Supports .litertlm and .task model formats.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "ios/**/*.swift",
    "ios/ExpoLitertLm.podspec",
    "ios/BinaryPods/CLiteRTLMBinary.podspec",
    "ios/BinaryPods/Frameworks/CLiteRTLM.xcframework",
    "src",
    "lib",
    "expo-module.config.json",
    "app.plugin.js",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "expo",
    "expo-modules",
    "litert",
    "litert-lm",
    "gemma",
    "gemma-4",
    "gemma-3n",
    "on-device",
    "ai",
    "llm",
    "ml",
    "android",
    "ios",
    "react-native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helenkwok/expo-litert-lm.git"
  },
  "author": "Helen Kwok",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/helenkwok/expo-litert-lm/issues"
  },
  "homepage": "https://github.com/helenkwok/expo-litert-lm#readme",
  "peerDependencies": {
    "@litert-lm/core": ">=0.12.0",
    "@mediapipe/tasks-genai": ">=0.10.27",
    "expo": ">=55.0.0",
    "expo-modules-core": ">=2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "@litert-lm/core": {
      "optional": true
    },
    "@mediapipe/tasks-genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@litert-lm/core": "^0.12.0",
    "@mediapipe/tasks-genai": "^0.10.27",
    "@types/react": "^19.0.0",
    "expo-modules-core": "^3.0.0",
    "react-native": "^0.83.0",
    "typescript": "^5.6.0"
  }
}
